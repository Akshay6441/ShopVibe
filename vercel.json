{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci --prefer-offline && CI=false npm run build",
  "outputDirectory": "frontend/build",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/tests/**,**/*.test.py,frontend/**,monitoring/**,compose.yaml,render.yaml}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/api", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
